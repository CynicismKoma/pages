---
import Particles, { initParticlesEngine } from "@tsparticles/astro";
import { loadSlim } from "@tsparticles/slim";
import type { ISourceOptions } from "@tsparticles/engine";

await initParticlesEngine(async (engine) => {
  await loadSlim(engine);
});

const lightColor = "#006cac";
const darkColor = "#ff6b01";

const options: ISourceOptions = {
  fullScreen: { zIndex: -1 },
  particles: {
    number: { value: 60, density: { enable: true } },
    color: { value: lightColor },
    shape: { type: "circle" },
    opacity: { value: 0.3 },
    size: { value: { min: 1, max: 3 } },
    links: {
      enable: true,
      distance: 120,
      color: lightColor,
      opacity: 0.15,
      width: 1,
    },
    move: {
      enable: true,
      speed: 0.8,
      direction: "none",
      random: true,
      straight: false,
      outModes: { default: "bounce" },
    },
  },
  interactivity: {
    events: {
      onHover: { enable: true, mode: "grab" },
      resize: { enable: true },
    },
    modes: {
      grab: { distance: 140, links: { opacity: 0.4 } },
    },
  },
  themes: [
    {
      name: "dark",
      default: { value: true, mode: "any" },
      options: {
        particles: {
          color: { value: darkColor },
          links: { color: darkColor },
        },
      },
    },
  ],
  detectRetina: true,
  fpsLimit: 60,
};
---

<Particles id="tsparticles" options={options} />

<style is:global>
  #tsparticles {
    position: fixed;
    inset: 0;
    pointer-events: none;
  }
  #tsparticles canvas {
    display: block;
  }
</style>

<script>
  (function () {
    const syncTheme = () => {
      const el = document.querySelector("astro-particles");
      if (!el) return;
      const theme = document.documentElement.getAttribute("data-theme");
      el.setAttribute("data-theme", theme === "dark" ? "dark" : "light");
    };
    syncTheme();
    const observer = new MutationObserver(syncTheme);
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  })();
</script>
