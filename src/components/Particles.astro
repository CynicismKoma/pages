---

---

<canvas id="tsparticles"></canvas>

<style is:global>
  #tsparticles {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { tsParticles, type Container, type ISourceOptions } from "@tsparticles/engine";
  import { loadSlim } from "@tsparticles/slim";

  function getOptions(color: string): ISourceOptions {
    return {
      fullScreen: { zIndex: 0 },
      particles: {
        number: { value: 60, density: { enable: true } },
        color: { value: color },
        shape: { type: "circle" },
        opacity: { value: 0.3 },
        size: { value: { min: 1, max: 3 } },
        links: {
          enable: true,
          distance: 120,
          color: color,
          opacity: 0.15,
          width: 1,
        },
        move: {
          enable: true,
          speed: 0.8,
          direction: "none",
          random: true,
          straight: false,
          outModes: { default: "bounce" },
        },
      },
      interactivity: {
        events: {
          onHover: { enable: true, mode: "grab" },
          resize: { enable: true },
        },
        modes: {
          grab: { distance: 140, links: { opacity: 0.4 } },
        },
      },
      detectRetina: true,
      fpsLimit: 60,
    };
  }

  const LIGHT = "#006cac";
  const DARK = "#ff6b01";

  let container: Container | null = null;

  async function startParticles(color: string) {
    if (container) {
      await container.destroy();
      container = null;
    }
    const result = await tsParticles.load({
      id: "tsparticles",
      options: getOptions(color),
    });
    if (result) container = result;
  }

  (async () => {
    await loadSlim(tsParticles);
    const isDark =
      document.documentElement.getAttribute("data-theme") === "dark";
    await startParticles(isDark ? DARK : LIGHT);
  })();

  const observer = new MutationObserver(() => {
    const isDark =
      document.documentElement.getAttribute("data-theme") === "dark";
    startParticles(isDark ? DARK : LIGHT);
  });
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>
