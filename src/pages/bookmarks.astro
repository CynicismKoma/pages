  function getBookmarks(): Bookmark[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      const ver = parseInt(localStorage.getItem(STORAGE_VER_KEY) || "0", 10);
      if (!raw || ver < STORAGE_VERSION) {
        saveBookmarks(DEFAULT_BOOKMARKS);
        return DEFAULT_BOOKMARKS;
      }
      return JSON.parse(raw);
    } catch {
      return [];
    }
  }

  function saveBookmarks(bookmarks: Bookmark[]) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    localStorage.setItem(STORAGE_VER_KEY, String(STORAGE_VERSION));
  }

  function buildTree(bookmarks: Bookmark[]): TreeNode[] {
    const root: TreeNode[] = [];

    for (const bm of bookmarks) {
      let level = root;
      for (const seg of bm.path) {
        let node = level.find((n) => n.name === seg);
        if (!node) {
          node = { name: seg, children: [], bookmarks: [] };
          level.push(node);
        }
        level = node.children;
      }
      level.push({ name: bm.title, children: [], bookmarks: [bm] });
    }

    return root;
  }

  function renderTree(nodes: TreeNode[], depth = 0): string {
    let html = "";

    const sorted = [...nodes].sort((a, b) => {
      const aIsFolder = a.bookmarks.length === 0 && a.children.length > 0;
      const bIsFolder = b.bookmarks.length === 0 && b.children.length > 0;
      if (aIsFolder && !bIsFolder) return -1;
      if (!aIsFolder && bIsFolder) return 1;
      if (aIsFolder && bIsFolder) return a.name.localeCompare(b.name, "zh");
      // Both are bookmarks
      return (a.bookmarks[0]?.createdAt || "").localeCompare(b.bookmarks[0]?.createdAt || "") * -1;
    });

    for (const node of sorted) {
      if (node.bookmarks.length === 1 && node.children.length === 0) {
        const bm = node.bookmarks[0];
        html += `
          <div class="border-border hover:border-accent/50 bg-background group/item relative rounded-lg border p-3 transition-colors">
            <a
              href="${bm.url}"
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent hover:underline mb-0.5 block truncate text-sm font-medium"
              title="${bm.title}"
            >
              ${bm.title}
            </a>
            <p class="text-muted-foreground truncate text-xs">${bm.url}</p>
            <button
              data-id="${bm.id}"
              class="text-muted-foreground hover:text-red-500 hover:bg-border/50 absolute top-1.5 right-1.5 flex size-6 items-center justify-center rounded text-base opacity-0 transition-all group-hover/item:opacity-100"
              title="删除"
            >×</button>
          </div>`;
      } else {
        const childHtml = node.bookmarks.length > 0
          ? node.bookmarks.map((bm) => `
            <div class="border-border hover:border-accent/50 bg-background group/item relative rounded-lg border p-3 transition-colors">
              <a
                href="${bm.url}"
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent hover:underline mb-0.5 block truncate text-sm font-medium"
                title="${bm.title}"
              >
                ${bm.title}
              </a>
              <p class="text-muted-foreground truncate text-xs">${bm.url}</p>
              <button
                data-id="${bm.id}"
                class="text-muted-foreground hover:text-red-500 hover:bg-border/50 absolute top-1.5 right-1.5 flex size-6 items-center justify-center rounded text-base opacity-0 transition-all group-hover/item:opacity-100"
                title="删除"
              >×</button>
            </div>`).join("")
          : "";

        const subHtml = renderTree(node.children, depth + 1);

        html += `
          <details class="group mb-3"${depth < 2 ? " open" : ""}>
            <summary class="hover:text-accent mb-2 flex cursor-pointer items-center gap-1.5 text-sm font-semibold select-none py-0.5">
              <span class="text-muted-foreground transition-transform group-open:rotate-90 text-xs leading-none">▶</span>
              <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
              ${node.name}
            </summary>
            ${childHtml ? `<div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3 mb-3">${childHtml}</div>` : ""}
            ${subHtml ? `<div class="ml-2 pl-2 border-l border-border">${subHtml}</div>` : ""}
          </details>`;
      }
    }

    return html;
  }

  function render() {
    const container = document.getElementById("bookmark-tree")!;
    const empty = document.getElementById("empty-state")!;
    const bookmarks = getBookmarks();

    if (bookmarks.length === 0) {
      container.innerHTML = "";
      empty.classList.remove("hidden");
      return;
    }
    empty.classList.add("hidden");

    const tree = buildTree(bookmarks);
    container.innerHTML = renderTree(tree);

    container.querySelectorAll("button[data-id]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = (btn as HTMLElement).dataset.id!;
        const bookmarks = getBookmarks().filter((b) => b.id !== id);
        saveBookmarks(bookmarks);
        render();
      });
    });
  }

  document.getElementById("bookmark-form")!.addEventListener("submit", (e) => {
    e.preventDefault();
    const title = (document.getElementById("bm-title") as HTMLInputElement).value.trim();
    const url = (document.getElementById("bm-url") as HTMLInputElement).value.trim();
    const pathStr = (document.getElementById("bm-path") as HTMLInputElement).value.trim();
    if (!title || !url) return;

    const path = pathStr ? pathStr.split("/").map((s) => s.trim()).filter(Boolean) : [];

    const bookmarks = getBookmarks();
    bookmarks.push({
      id: Date.now().toString(36) + Math.random().toString(36).slice(2, 6),
      title,
      url,
      path,
      createdAt: new Date().toISOString(),
    });
    saveBookmarks(bookmarks);
    (document.getElementById("bm-title") as HTMLInputElement).value = "";
    (document.getElementById("bm-url") as HTMLInputElement).value = "";
    (document.getElementById("bm-path") as HTMLInputElement).value = "";
    render();
  });

  document.addEventListener("astro:page-load", render);
</script>
